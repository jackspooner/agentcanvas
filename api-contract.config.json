{
  "openapi": {
    "document": "docs/openapi.standard.json",
    "freshnessCommand": "npm run check:openapi"
  },
  "mcp": {
    "catalog": "docs/mcp-tools.standard.json",
    "freshnessCommand": "npm run check:mcp-contract"
  },
  "compatibility": {
    "baselineRef": "origin/main",
    "waivers": [
      {
        "ruleId": "ARC711",
        "location": "*:response:*:error-envelope",
        "reason": "AgentCanvas is adopting RFC 9457 Problem Details before its stable 1.0 release.",
        "migration": "docs/upgrading.md#030-alpha2",
        "owner": "AgentCanvas",
        "expires": "2026-11-30"
      },
      {
        "ruleId": "ARC755",
        "location": "canvas_*",
        "reason": "Pre-1.0 MCP canvas mutations now return bounded receipts instead of full documents.",
        "migration": "docs/upgrading.md#compact-mcp-mutation-receipts",
        "owner": "AgentCanvas",
        "expires": "2026-12-31"
      },
      {
        "ruleId": "ARC755",
        "location": "macro_create*",
        "reason": "Pre-1.0 MCP macro writes now return bounded version receipts.",
        "migration": "docs/upgrading.md#compact-mcp-mutation-receipts",
        "owner": "AgentCanvas",
        "expires": "2026-12-31"
      },
      {
        "ruleId": "ARC755",
        "location": "macro_plan",
        "reason": "Pre-1.0 MCP macro planning now returns a bounded plan receipt.",
        "migration": "docs/upgrading.md#lean-mcp-catalog-and-bounded-reads",
        "owner": "AgentCanvas",
        "expires": "2026-12-31"
      },
      {
        "ruleId": "ARC755",
        "location": "agentcanvas_markdown__add_document",
        "reason": "The bundled Markdown mutation now returns a flat bounded canvas receipt.",
        "migration": "docs/upgrading.md#compact-mcp-mutation-receipts",
        "owner": "AgentCanvas",
        "expires": "2026-12-31"
      },
      {
        "ruleId": "ARC755",
        "location": "agentcanvas_primitives__add_*",
        "reason": "Bundled primitive mutations now return flat bounded canvas receipts.",
        "migration": "docs/upgrading.md#compact-mcp-mutation-receipts",
        "owner": "AgentCanvas",
        "expires": "2026-12-31"
      },
      {
        "ruleId": "ARC755",
        "location": "agentcanvas_table__add_table",
        "reason": "The bundled table mutation now returns a flat bounded canvas receipt.",
        "migration": "docs/upgrading.md#compact-mcp-mutation-receipts",
        "owner": "AgentCanvas",
        "expires": "2026-12-31"
      }
    ]
  },
  "ratchet": {
    "baseline": ".api-contract-baseline.json"
  },
  "reports": {
    "errorCodes": "docs/error-codes.json"
  },
  "consumers": [
    {
      "name": "internal-dependency-pin",
      "freshnessCommand": "npm run check:internal-deps"
    }
  ]
}
