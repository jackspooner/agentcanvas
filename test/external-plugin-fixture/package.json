{
  "name": "agentcanvas-external-plugin-fixture",
  "version": "1.0.0",
  "private": true,
  "description": "Third-party-style AgentCanvas plugin acceptance fixture.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true }); require('fs').rmSync('plugin-dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "pack:plugin": "npm run build && node scripts/pack-plugin.mjs",
    "agentcanvas:verify": "node scripts/verify-distribution.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@agentcanvas/plugin-sdk": "0.3.0-alpha.1"
  },
  "devDependencies": {
    "@agentcanvas/plugin-testkit": "0.3.0-alpha.1",
    "@types/node": "^26.1.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
