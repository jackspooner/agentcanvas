{
  "name": "@agentcanvas/plugin-primitives",
  "version": "0.2.1",
  "description": "First-party text, shape, line, and arrow plugin for AgentCanvas.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "files": [
    "agentcanvas.plugin.json",
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.test.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentcanvas/plugin-sdk": "0.3.0-alpha.2"
  },
  "devDependencies": {
    "@agentcanvas/plugin-testkit": "0.3.0-alpha.1"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
