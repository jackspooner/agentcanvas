    "test": "vitest run"
  },
  "dependencies": {
    "@agentcanvas/plugin-sdk": "0.2.0",
    "@google/model-viewer": "^4.3.1"
  },
  "devDependencies": {
    "@agentcanvas/plugin-testkit": "0.2.0",
    "vite": "^8.1.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
