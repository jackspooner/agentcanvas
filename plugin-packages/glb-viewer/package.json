{
  "name": "@agentcanvas/plugin-glb-viewer",
  "version": "0.2.0",
  "description": "First-party single-GLB viewer plugin for AgentCanvas.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "files": [
    "agentcanvas.plugin.json",
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && vite build",
