{
  "apiVersion": "agentcanvas.plugin/v1",
  "id": "agentcanvas.glb-viewer",
  "version": "0.2.0",
  "displayName": "AgentCanvas GLB viewer",
  "description": "Assets-2-backed single-GLB model viewer elements.",
  "license": "MIT",
  "entrypoints": {
    "server": "dist/server.mjs",
    "browser": "dist/browser/entry.mjs"
  },
  "requires": {
    "hostApi": "^1.0.0",
    "plugins": {},
    "capabilities": { "agentcanvas.assets": "^1.0.0" }
  },
  "provides": { "capabilities": {} },
  "permissions": ["canvas.read", "canvas.mutate-own", "assets.read", "diagnostics.emit"],
  "contributes": {
    "elements": [{ "name": "model", "schemaVersion": 1, "browser": true, "snapshot": "supported" }],
    "tools": ["place"],
    "procedures": ["details"],
    "migrations": ["legacy-glb-v1"]
  }
}
