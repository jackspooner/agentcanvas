import { createHash } from 'node:crypto';
import { readFile, writeFile } from 'node:fs/promises';
import { fileURLToPath } from 'node:url';
import { Ajv2020 } from 'ajv/dist/2020.js';
import standaloneCode from 'ajv/dist/standalone/index.js';
import { build } from 'esbuild';
import { erdDataSchema, erdOperationSchema } from '../src/erd-schemas.js';
import { mermaidDataSchema } from '../src/schemas.js';

const schemas = { validShape: erdDataSchema, validOperation: erdOperationSchema, validMermaid: mermaidDataSchema };
const ajv = new Ajv2020({ allErrors: true, strict: true, code: { source: true, esm: true } });
for (const [name, schema] of Object.entries(schemas)) ajv.addSchema(schema, name);
const generated = standaloneCode(ajv, Object.fromEntries(Object.keys(schemas).map((key) => [key, key])));
const bundled = await build({
  absWorkingDir: fileURLToPath(new URL('..', import.meta.url)),
  stdin: { contents: generated, resolveDir: fileURLToPath(new URL('..', import.meta.url)), loader: 'js' },
  bundle: true,
  write: false,
  format: 'esm',
  platform: 'browser',
  target: 'es2022',
  legalComments: 'none'
});
const hash = createHash('sha256').update(JSON.stringify(schemas)).digest('hex');
const content = `// @ts-nocheck -- Generated JavaScript validator implementation.\n// Generated by: tsx scripts/generate-validators.mts (do not edit).\n// Canonical diagram schemas SHA-256: ${hash}\n${bundled.outputFiles[0].text}`;
const output = new URL('../src/schema-validators.ts', import.meta.url);
if (process.argv.includes('--check')) {
  if ((await readFile(output, 'utf8')) !== content)
    throw new Error('Diagram validators are stale; run tsx scripts/generate-validators.mts');
} else await writeFile(output, content);
