{
  "name": "@agentcanvas/extension-mediatools",
  "version": "0.1.0",
  "description": "Optional MediaTools image-job bindings for AgentCanvas.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "files": [
    "agentcanvas.plugin.json",
    "plugin.config.json",
    "schemas",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "clean": "node --input-type=module -e \"import{rm}from'node:fs/promises';await rm('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && npm run check && node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run check && vitest run",
    "generate:notices": "node scripts/build.mjs",
    "check:notices": "node scripts/build.mjs --check-notices"
  },
  "dependencies": {
    "@agentcanvas/core": "0.2.1",
    "@agentcanvas/extension-sdk": "0.3.0-alpha.4",
    "media-tools-mcp": "file:../../.cutlery/deps/media-tools-mcp"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
