{
  "name": "@agentcanvas/plugin-image-overlays",
  "version": "0.2.0",
  "description": "Optional first-party bbox and path overlay plugin for AgentCanvas.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "files": [
    "agentcanvas.plugin.json",
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && vite build --mode server && vite build --mode browser",
    "check": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentcanvas/plugin-sdk": "0.3.0-alpha.3",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@agentcanvas/plugin-testkit": "0.3.0-alpha.1",
    "ajv": "8.20.0",
    "vite": "^8.1.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
