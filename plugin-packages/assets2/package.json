{
  "name": "@agentcanvas/plugin-assets2",
  "version": "0.2.0",
  "description": "Optional Assets-2 capability and asset element extension for AgentCanvas.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "files": [
    "agentcanvas.plugin.json",
    "plugin.config.json",
    "schemas",
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json && vite build",
    "check": "tsc -p tsconfig.test.json --noEmit",
    "pretest": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentcanvas/plugin-sdk": "0.3.0-alpha.3"
  },
  "devDependencies": {
    "@agentcanvas/plugin-testkit": "0.3.0-alpha.1",
    "@types/node": "^26.1.0",
    "vite": "^8.1.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
