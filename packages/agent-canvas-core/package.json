{
  "name": "@agentcanvas/core",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "AgentCanvas canvas/document kernel contracts.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./validation": { "types": "./dist/validation.d.ts", "import": "./dist/validation.js" },
    "./errors": { "types": "./dist/errors.d.ts", "import": "./dist/errors.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentcanvas/plugin-sdk": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
