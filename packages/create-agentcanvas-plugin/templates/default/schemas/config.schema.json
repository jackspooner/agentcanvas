{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["accentColor", "maxMessageLength"],
  "additionalProperties": false,
  "properties": {
    "accentColor": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "maxMessageLength": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    }
  }
}
