{
  "name": "__PACKAGE_NAME__",
  "version": "0.1.0",
  "description": "A standalone AgentCanvas Hello Card extension.",
  "license": "MIT",
  "type": "module",
  "files": [
    "agentcanvas.plugin.json",
    "plugin.config.json",
    "schemas",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true }); require('fs').rmSync('plugin-dist', { recursive: true, force: true })\"",
    "generate:manifest": "tsx scripts/generate-manifest.mts",
    "build": "npm run generate:manifest && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "pack:extension": "npm run build && node scripts/pack-plugin.mjs",
    "pack:plugin": "npm run pack:extension",
    "agentcanvas:verify": "node scripts/verify-distribution.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@agentcanvas/extension-sdk": "^0.3.0-alpha.3"
  },
  "devDependencies": {
    "@agentcanvas/extension-testkit": "^0.3.0-alpha.2",
    "@types/node": "^26.1.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
