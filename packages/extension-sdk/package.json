{
  "name": "@agentcanvas/extension-sdk",
  "version": "0.3.0-alpha.1",
  "description": "Public authoring facade for AgentCanvas extensions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackspooner/AgentCanvas.git",
    "directory": "packages/extension-sdk"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agentcanvas/plugin-sdk": "0.2.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
