{
  "name": "@agentcanvas/plugin-testkit",
  "version": "0.3.0-alpha.1",
  "description": "Conformance helpers for AgentCanvas plugin distributions using the canonical manifest schema.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackspooner/agentcanvas.git",
    "directory": "packages/plugin-testkit"
  },
  "bugs": {
    "url": "https://github.com/jackspooner/agentcanvas/issues"
  },
  "homepage": "https://github.com/jackspooner/agentcanvas#readme",
  "keywords": [
    "agentcanvas",
    "canvas",
    "plugin",
    "testing",
    "conformance"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@agentcanvas/plugin-sdk": "0.3.0-alpha.2",
    "ajv": "^8.20.0"
  }
}
