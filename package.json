{
  "name": "agent-canvas",
  "version": "0.1.0",
  "description": "Clone-and-run local web canvas and MCP server for agent-created boards.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jackspooner/AgentCanvas.git"
  },
  "bugs": {
    "url": "https://github.com/jackspooner/AgentCanvas/issues"
  },
  "homepage": "https://github.com/jackspooner/AgentCanvas#readme",
  "keywords": [
    "agent-canvas",
    "mcp",
    "canvas",
    "workspace"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace @agentcanvas/media-contracts && npm run build --workspace @agentcanvas/core",
    "test:packages": "npm run test --workspace @agentcanvas/media-contracts && npm run test --workspace @agentcanvas/core",
    "dev": "npm run build:packages && tsx src/server.ts",
    "build": "npm run build:packages && tsc --noEmit && vite build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --diagnostic-level=error .",
    "mcp": "npm run build:packages && tsx src/mcp/index.ts",
    "test": "npm run build:packages && npm run test:packages && vitest run",
    "test:app": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentcanvas/core": "0.1.0",
    "@agentcanvas/media-contracts": "0.1.0",
    "@google/model-viewer": "^4.3.1",
    "@hono/node-server": "^2.0.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "17.4.2",
    "hono": "^4.12.28",
    "jszip": "^3.10.1",
    "nanoid": "^5.1.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
