{
  "name": "agent-canvas",
  "version": "0.2.0",
  "description": "Clone-and-run local web canvas and MCP server for agent-created boards.",
  "private": true,
  "bin": {
    "agentcanvas": "bin/agentcanvas.mjs"
  },
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "plugin-packages/*"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jackspooner/AgentCanvas.git"
  },
  "bugs": {
    "url": "https://github.com/jackspooner/AgentCanvas/issues"
  },
  "homepage": "https://github.com/jackspooner/AgentCanvas#readme",
  "keywords": [
    "agent-canvas",
    "mcp",
    "canvas",
    "workspace"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace @agentcanvas/plugin-sdk && npm run build --workspace @agentcanvas/plugin-testkit && npm run build --workspace @agentcanvas/core && npm run build --workspace create-agentcanvas-plugin",
    "test:packages": "npm run test --workspaces --if-present",
    "check:packages": "npm run check --workspaces --if-present",
    "dev": "npm run build:packages && tsx src/server.ts",
    "build": "npm run build:packages && tsc --noEmit && vite build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --diagnostic-level=error .",
    "mcp": "npm run build:packages && tsx src/mcp-v2/stdio.ts",
    "migrate": "tsx src/cli/main.ts migrate",
    "plugins:build": "npm run build --workspaces --if-present && tsx src/cli/plugins-main.ts catalog",
    "plugins:list": "tsx src/cli/plugins-main.ts list",
    "plugins:materialize": "tsx src/cli/plugins-main.ts materialize",
    "plugins:install": "tsx src/cli/plugins-main.ts install",
    "plugins:disable": "tsx src/cli/plugins-main.ts disable",
    "plugins:verify": "tsx src/cli/plugins-main.ts verify",
    "generate:openapi": "tsx src/cli/openapi.ts generate",
    "check:openapi": "tsx src/cli/openapi.ts check",
    "check:docs": "node scripts/check-docs.mjs",
    "check:plugin-licenses": "node scripts/verify-plugin-distribution-licenses.mjs",
    "check:release": "node scripts/check-public-release.mjs && npm run check:plugin-licenses",
    "test": "npm run build:packages && npm run check:packages && npm run test:packages && npm run test:external-plugin && vitest run",
    "test:external-plugin": "npm --prefix test/external-plugin-fixture run check && npm --prefix test/external-plugin-fixture test && npm --prefix test/external-plugin-fixture run pack:plugin && npm --prefix test/external-plugin-fixture run agentcanvas:verify",
    "test:e2e": "playwright test --config test/e2e/playwright.config.ts",
    "test:app": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentcanvas/core": "0.2.0",
    "@agentcanvas/plugin-sdk": "0.2.0",
    "@hono/node-server": "^2.0.8",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.20.0",
    "dotenv": "17.4.2",
    "hono": "^4.12.28",
    "nanoid": "^5.1.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10"
  }
}
