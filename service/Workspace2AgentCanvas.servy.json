{
  "Name": "Workspace2AgentCanvas",
  "DisplayName": "Workspace2 AgentCanvas",
  "Description": "Local agent-operable web canvas for Workspace2; requires Assets-2 for durable media identity and bytes.",
  "ExecutablePath": "C:/Program Files/nodejs/node.exe",
  "StartupDirectory": "C:/path/to/AgentCanvas",
  "Parameters": "--require C:/path/to/AgentCanvas/node_modules/tsx/dist/preflight.cjs --import file:///C:/path/to/AgentCanvas/node_modules/tsx/dist/loader.mjs src/server.ts",
  "Environment": {
    "AGENT_CANVAS_DB": "C:/path/to/AgentCanvas/data/agent-canvas.sqlite",
    "AGENT_CANVAS_HOST": "127.0.0.1",
    "AGENT_CANVAS_PORT": "23003",
    "AGENT_CANVAS_PUBLIC_BASE_URL": "http://127.0.0.1:23003",
    "ASSETS_BASE_URL": "http://127.0.0.1:23000",
    "AGENT_CANVAS_ASSET_FETCH_TIMEOUT_MS": "10000",
    "AGENT_CANVAS_ASSET_METADATA_MAX_BYTES": "1048576",
    "AGENT_CANVAS_ASSET_PREVIEW_MAX_BYTES": "8388608",
    "AGENT_CANVAS_ASSET_PROXY_MAX_BYTES": "268435456"
  },
  "ServiceDependencies": "Workspace2Assets2",
  "StdoutPath": "C:/path/to/AgentCanvas/data/logs/AgentCanvas.stdout.log",
  "StderrPath": "C:/path/to/AgentCanvas/data/logs/AgentCanvas.stderr.log",
  "NoConsole": true,
  "RestartOnExit": true,
  "RunAsLocalSystem": false,
  "StartupType": 2
}
