{
  "Name": "AgentCanvas",
  "DisplayName": "AgentCanvas",
  "Description": "Local loopback-only agent-operable web canvas and MCP service.",
  "ExecutablePath": "C:/Program Files/nodejs/node.exe",
  "StartupDirectory": "C:/path/to/AgentCanvas",
  "Parameters": "--import tsx src/server.ts",
  "EnvironmentVariables": "AGENT_CANVAS_DB=C:/path/to/AgentCanvas/data/agent-canvas.sqlite;AGENT_CANVAS_HOST=127.0.0.1;AGENT_CANVAS_PORT=23003;AGENT_CANVAS_PUBLIC_BASE_URL=http://127.0.0.1:23003",
  "StdoutPath": "C:/path/to/AgentCanvas/data/logs/AgentCanvas.stdout.log",
  "StderrPath": "C:/path/to/AgentCanvas/data/logs/AgentCanvas.stderr.log",
  "EnableConsoleUI": false,
  "RecoveryAction": 1,
  "MaxRestartAttempts": 3,
  "RunAsLocalSystem": false,
  "UserAccount": "NT SERVICE\\AgentCanvas",
  "StartupType": 2
}
