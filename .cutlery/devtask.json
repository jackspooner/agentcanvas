{
  "schemaVersion": 1,
  "name": "agentcanvas",
  "units": {
    "internal-deps": {
      "kind": "prepare",
      "owner": "internal-deps",
      "inputs": [
        ".cutlery/internal-deps.toml",
        "scripts/internal-dependencies.mjs"
      ],
      "outputs": [
        ".cutlery/deps"
      ],
      "environmentInputs": [
        "WORKSPACE2_LINUX_ROOT",
        "WORKSPACE2_LINUX_YTDLP_COMMIT",
        "WORKSPACE2_INTERNAL_DEPS_CLI"
      ]
    },
    "install": {
      "kind": "prepare",
      "command": [
        "npm",
        "ci"
      ],
      "dependsOn": [
        "internal-deps"
      ],
      "inputs": [
        "package.json",
        "package-lock.json",
        ".npmrc",
        ".nvmrc",
        "packages/*/package.json",
        "plugin-packages/*/package.json"
      ],
      "outputs": [
        "node_modules/typescript/bin/tsc",
        "node_modules/vitest/vitest.mjs",
        "node_modules/@playwright/test/cli.js"
      ],
      "probe": [
        "node",
        "--input-type=module",
        "-e",
        "import '@workspace2/api-contracts';import 'media-tools-mcp/client';import 'typescript';import 'vitest/config';import '@playwright/test'"
      ],
      "versionCommand": [
        "npm",
        "--version"
      ]
    },
    "dependency-readiness": {
      "kind": "prepare",
      "command": [
        "npm",
        "run",
        "check:internal-deps"
      ],
      "dependsOn": [
        "install"
      ],
      "inputs": [
        "scripts/internal-dependencies.mjs",
        ".cutlery/internal-deps.toml"
      ],
      "probe": [
        "node",
        "--input-type=module",
        "-e",
        "import '@workspace2/api-contracts'"
      ],
      "environmentInputs": [
        "WORKSPACE2_LINUX_ROOT",
        "WORKSPACE2_LINUX_YTDLP_COMMIT",
        "WORKSPACE2_INTERNAL_DEPS_CLI"
      ]
    },
    "build-packages": {
      "kind": "build",
      "command": [
        "npm",
        "run",
        "build:packages"
      ],
      "dependsOn": [
        "dependency-readiness"
      ],
      "inputs": [
        "packages/**",
        "package.json",
        "tsconfig*.json"
      ],
      "outputs": [
        "packages/agent-canvas-core/dist",
        "packages/create-agentcanvas-extension/dist",
        "packages/create-agentcanvas-plugin/dist",
        "packages/editor/dist",
        "packages/extension-sdk/dist",
        "packages/extension-testkit/dist",
        "packages/plugin-sdk/dist",
        "packages/plugin-testkit/dist"
      ],
      "versionCommand": [
        "node",
        "--version"
      ]
    },
    "build-plugins": {
      "kind": "build",
      "command": [
        "npm",
        "run",
        "build:plugins"
      ],
      "dependsOn": [
        "build-packages"
      ],
      "inputs": [
        "plugin-packages/**",
        "package.json"
      ],
      "outputs": [
        "plugin-packages/assets2/dist",
        "plugin-packages/diagrams/dist",
        "plugin-packages/filesystem-images/dist",
        "plugin-packages/gallery/dist",
        "plugin-packages/glb-viewer/dist",
        "plugin-packages/image-overlays/dist",
        "plugin-packages/markdown/dist",
        "plugin-packages/mediatools/dist",
        "plugin-packages/primitives/dist",
        "plugin-packages/table/dist",
        "plugin-packages/video/dist"
      ],
      "versionCommand": [
        "node",
        "--version"
      ]
    },
    "build-catalog": {
      "kind": "build",
      "command": [
        "node",
        "node_modules/tsx/dist/cli.mjs",
        "src/cli/plugins-main.ts",
        "catalog"
      ],
      "dependsOn": [
        "build-plugins"
      ],
      "inputs": [
        "src/**",
        "package.json",
        "scripts/**"
      ],
      "outputs": [
        "dist/plugin-catalog"
      ],
      "versionCommand": [
        "node",
        "--version"
      ]
    },
    "build-web": {
      "kind": "build",
      "command": [
        "npm",
        "run",
        "build"
      ],
      "dependsOn": [
        "build-packages"
      ],
      "inputs": [
        "src/**",
        "public/**",
        "index.html",
        "vite.config.*",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": [
        "dist/web"
      ],
      "versionCommand": [
        "node",
        "--version"
      ]
    },
    "format-check": {
      "kind": "check",
      "command": [
        "npm",
        "run",
        "format:check"
      ],
      "dependsOn": [
        "build-catalog",
        "build-web"
      ],
      "resources": [
        "repository-checks"
      ],
      "environmentInputs": [
        "WORKSPACE2_LINUX_ROOT",
        "WORKSPACE2_LINUX_YTDLP_COMMIT",
        "WORKSPACE2_INTERNAL_DEPS_CLI"
      ]
    },
    "lint": {
      "kind": "check",
      "command": [
        "npm",
        "run",
        "lint"
      ],
      "dependsOn": [
        "build-catalog",
        "build-web"
      ],
      "resources": [
        "repository-checks"
      ],
      "environmentInputs": [
        "WORKSPACE2_LINUX_ROOT",
        "WORKSPACE2_LINUX_YTDLP_COMMIT",
        "WORKSPACE2_INTERNAL_DEPS_CLI"
      ]
    },
    "test": {
      "kind": "check",
      "command": [
        "npm",
        "run",
        "test"
      ],
      "dependsOn": [
        "build-catalog",
        "build-web"
      ],
      "resources": [
        "repository-checks"
      ],
      "environmentInputs": [
        "WORKSPACE2_LINUX_ROOT",
        "WORKSPACE2_LINUX_YTDLP_COMMIT",
        "WORKSPACE2_INTERNAL_DEPS_CLI"
      ]
    },
    "test-e2e": {
      "kind": "check",
      "command": [
        "npm",
        "run",
        "test:e2e"
      ],
      "dependsOn": [
        "build-catalog",
        "build-web"
      ],
      "resources": [
        "repository-checks"
      ],
      "environmentInputs": [
        "WORKSPACE2_LINUX_ROOT",
        "WORKSPACE2_LINUX_YTDLP_COMMIT",
        "WORKSPACE2_INTERNAL_DEPS_CLI",
        "CI",
        "PLAYWRIGHT_BROWSERS_PATH"
      ]
    },
    "plugins-verify": {
      "kind": "check",
      "command": [
        "npm",
        "run",
        "plugins:verify"
      ],
      "dependsOn": [
        "build-catalog",
        "build-web"
      ],
      "resources": [
        "repository-checks"
      ],
      "environmentInputs": [
        "WORKSPACE2_LINUX_ROOT",
        "WORKSPACE2_LINUX_YTDLP_COMMIT",
        "WORKSPACE2_INTERNAL_DEPS_CLI"
      ]
    },
    "check-openapi": {
      "kind": "check",
      "command": [
        "npm",
        "run",
        "check:openapi"
      ],
      "dependsOn": [
        "build-catalog",
        "build-web"
      ],
      "resources": [
        "repository-checks"
      ],
      "environmentInputs": [
        "WORKSPACE2_LINUX_ROOT",
        "WORKSPACE2_LINUX_YTDLP_COMMIT",
        "WORKSPACE2_INTERNAL_DEPS_CLI"
      ]
    },
    "check-mcp-contract": {
      "kind": "check",
      "command": [
        "npm",
        "run",
        "check:mcp-contract"
      ],
      "dependsOn": [
        "build-catalog",
        "build-web"
      ],
      "resources": [
        "repository-checks"
      ],
      "environmentInputs": [
        "WORKSPACE2_LINUX_ROOT",
        "WORKSPACE2_LINUX_YTDLP_COMMIT",
        "WORKSPACE2_INTERNAL_DEPS_CLI"
      ]
    },
    "check-contracts": {
      "kind": "check",
      "command": [
        "npm",
        "run",
        "check:contracts"
      ],
      "dependsOn": [
        "build-catalog",
        "build-web"
      ],
      "resources": [
        "repository-checks"
      ],
      "environmentInputs": [
        "WORKSPACE2_LINUX_ROOT",
        "WORKSPACE2_LINUX_YTDLP_COMMIT",
        "WORKSPACE2_INTERNAL_DEPS_CLI"
      ]
    },
    "check-docs": {
      "kind": "check",
      "command": [
        "npm",
        "run",
        "check:docs"
      ],
      "dependsOn": [
        "build-catalog",
        "build-web"
      ],
      "resources": [
        "repository-checks"
      ],
      "environmentInputs": [
        "WORKSPACE2_LINUX_ROOT",
        "WORKSPACE2_LINUX_YTDLP_COMMIT",
        "WORKSPACE2_INTERNAL_DEPS_CLI"
      ]
    },
    "test-setup-verification": {
      "kind": "check",
      "command": [
        "npm",
        "run",
        "test:setup:verification"
      ],
      "dependsOn": [
        "build-catalog",
        "build-web"
      ],
      "resources": [
        "repository-checks"
      ],
      "environmentInputs": [
        "WORKSPACE2_LINUX_ROOT",
        "WORKSPACE2_LINUX_YTDLP_COMMIT",
        "WORKSPACE2_INTERNAL_DEPS_CLI"
      ]
    }
  },
  "scopes": {
    "full": {
      "units": [
        "dependency-readiness"
      ]
    },
    "docs": {
      "units": [
        "build-catalog",
        "build-web"
      ],
      "graph": false
    }
  },
  "verification": {
    "full": [
      "format-check",
      "lint",
      "test",
      "test-e2e",
      "plugins-verify",
      "check-openapi",
      "check-mcp-contract",
      "check-contracts",
      "check-docs",
      "test-setup-verification"
    ],
    "docs": [
      "format-check",
      "lint",
      "test",
      "test-e2e",
      "plugins-verify",
      "check-openapi",
      "check-mcp-contract",
      "check-contracts",
      "check-docs",
      "test-setup-verification"
    ]
  },
  "changes": [
    {
      "patterns": [
        "README.md",
        "AGENTS.md",
        "skills/**",
        "docs/**"
      ],
      "scopes": [
        "docs"
      ]
    }
  ]
}
